# Copy to .env and fill in. Never commit the real .env - it's gitignored.

# Shared secret the Worker gate must present on every forwarded request
# (see worker/wrangler.toml's MERCURY_SHARED_SECRET, set via `wrangler secret put`).
MERCURY_SHARED_SECRET=

# Prompt-injection classifier endpoint. Must implement the contract described
# in providers/classifier.py: POST {"text": "..."} -> {"label": "SAFE"|"INJECTION", "score": <float>}.
PROMPT_INJECTION_CLASSIFIER_URL=http://localhost:8009/classify

# Agent gateway endpoint - see gateway/README.md. Must implement the contract
# described in providers/judge.py: POST {"prompt": "..."} -> {"response": "..."}.
AGENT_GATEWAY_URL=http://localhost:8721/agent
AGENT_GATEWAY_SECRET=

# Telegram notifier (the one built-in NotifierProvider - see providers/notifier.py).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
