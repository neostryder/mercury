# Copy to .env and fill in. Never commit the real .env - it's gitignored.

# Shared secret the Worker gate must present on every forwarded request
# (see worker/wrangler.toml's MERCURY_SHARED_SECRET, set via `wrangler secret put`).
MERCURY_SHARED_SECRET=

# Versioned filtering policy. A legacy flat {"rules": [...]} file at this
# path is migrated atomically on first read.
MERCURY_RULES_LEDGER_PATH=/data/rules_ledger.json

# Prompt-injection classifier endpoint. Must implement the contract described
# in providers/classifier.py: POST {"text": "..."} -> {"label": "SAFE"|"INJECTION", "score": <float>}.
PROMPT_INJECTION_CLASSIFIER_URL=http://localhost:8009/classify

# Agent gateway endpoint - see gateway/README.md. Must implement the contract
# described in providers/judge.py: POST {"prompt": "..."} -> {"response": "..."}.
AGENT_GATEWAY_URL=http://host.docker.internal:8721/agent
AGENT_GATEWAY_SECRET=

# Telegram notifier (the one built-in NotifierProvider - see providers/notifier.py).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram allows only one long-poll getUpdates holder per bot. Set to false
# when another always-on process (e.g. a Hermes/Loremaster gateway) already
# holds this bot's receive side - approval replies then need to reach Mercury
# some other way instead of telegram_approvals.py's own poll_forever().
MERCURY_TELEGRAM_POLLING_ENABLED=true

# Daily digest email (backend/digest.py). The dashboard routes it reads from
# sit behind a Cloudflare Access application; these are the Client ID/Secret
# of a Service Token issued to a Service Auth policy on that application (Zero
# Trust dashboard -> Access -> Service credentials), not a human login.
# SMTP credentials are for the sending mailbox (gandalf@rpgm.tools) on
# ForwardEmail's own SMTP. Unset either pair and the digest logs a skip reason
# at startup instead of running.
MERCURY_DIGEST_ID=
MERCURY_DIGEST_SECRET=
MERCURY_DIGEST_SMTP_USER=
MERCURY_DIGEST_SMTP_PASSWORD=

# Newsletter mail pushed to Juhandu, the feed reader (backend/juhandu_bridge.py).
# Off unless MERCURY_JUHANDU_PUSH is true and the URL and token are set. The URL
# is Juhandu's mail door; from inside the backend container the private path is
# http://host.docker.internal:8795/inbound/mail. The token is made on Juhandu's
# Connect screen. The Access pair is only needed when the URL is the public
# hostname behind Cloudflare Access. CATEGORIES is a comma-separated list.
MERCURY_JUHANDU_PUSH=false
MERCURY_JUHANDU_URL=
MERCURY_JUHANDU_TOKEN=
MERCURY_JUHANDU_CATEGORIES=NEWSLETTER
# Optional Host header the Juhandu bridge sends with each request. Empty by default.
# Set it to 127.0.0.1:8795 when the bridge uses the private address (host.docker.internal), because Juhandu answers 403 to a host name it does not listen under.
# Leave it empty for the public hostname.
MERCURY_JUHANDU_HOST=
MERCURY_JUHANDU_ACCESS_ID=
MERCURY_JUHANDU_ACCESS_SECRET=

# Structured judge (backend/providers/structured_judge.py). Off entirely unless
# STRUCTURED_JUDGE_ENABLED is true, in which case the pipeline behaves exactly
# as it did before. Enabled, it runs alongside the judge on the same message and
# only writes disagreements to the judge_comparisons log. It decides nothing
# until STRUCTURED_JUDGE_AUTHORITATIVE is also true, so the thresholds in
# backend/verdict_policy.py can be read off real disagreements first.
# Apply worker/schema.sql before enabling: the table has to exist.
STRUCTURED_JUDGE_ENABLED=false
STRUCTURED_JUDGE_AUTHORITATIVE=false
# TypeSafe System One credentials. TYPESAFE_API_KEY is the name the vendor's own
# SDKs read; JEV_API_KEY is accepted as a fallback.
TYPESAFE_API_KEY=
# Augur's Jev gateway (optional). With both set, the judge calls it first and goes
# direct with TYPESAFE_API_KEY only when the gateway is unreachable or fails on its own.
# STRUCTURED_JUDGE_GATEWAY_URL=http://host.docker.internal:8020/v1/systemone
# STRUCTURED_JUDGE_GATEWAY_TOKEN=
# Second structured backend (backend/laya_shadow.py): any server accepting the same /v1/systemone request, such as a self-hosted open-weight model. List several endpoints separated by commas to try them in order; a server that is down, busy or not ready is skipped. Unset means no shadow. It answers in the background and decides nothing unless LAYA_FAILOVER is true and its calibration has been judged ready.
LAYA_URL=
LAYA_FAILOVER=false
