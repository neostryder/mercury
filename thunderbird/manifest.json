{
  "manifest_version": 3,
  "name": "Mercury Rule Flagger",
  "version": "0.3.2",
  "description": "Flag a message and describe in plain language how it should be handled.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mercury-rule-flagger@example.com",
      "strict_min_version": "128.0",
      "update_url": "https://raw.githubusercontent.com/neostryder/mercury/main/thunderbird/updates.json"
    }
  },
  "permissions": ["messagesRead", "storage", "menus"],
  "host_permissions": ["*://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "message_display_action": {
    "default_popup": "popup.html",
    "default_title": "Flag for Mercury",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "64": "icons/icon-64.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
