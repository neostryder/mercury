{
  "manifest_version": 3,
  "name": "Mercury Rule Flagger",
  "version": "0.3.0",
  "description": "Flag a message and describe in plain language how it should be handled.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mercury-rule-flagger@example.com",
      "strict_min_version": "128.0",
      "update_url": "https://raw.githubusercontent.com/neostryder/mercury/main/thunderbird/updates.json"
    }
  },
  "permissions": ["messagesRead", "storage", "menus"],
  "host_permissions": ["*://*/*"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "message_display_action": {
    "default_popup": "popup.html",
    "default_title": "Flag for Mercury"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
